{
  "name": "@atp/playwright-reporter",
  "version": "0.1.1",
  "description": "Playwright reporter that streams runs, results and artifacts to the Automation Testing Platform (SPEC §7).",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": ["dist/src", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "example": "npm run build && playwright test --config example/playwright.config.ts"
  },
  "peerDependencies": { "@playwright/test": ">=1.40" },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
