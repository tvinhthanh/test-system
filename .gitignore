# npm deps (reporter, checker and frontend each install their own).
node_modules/

# Go build output. The prototype is run with `go run ./cmd/protoident`,
# never from a committed binary.
protoident
protoident.exe
*.test
*.exe

# OS noise
Thumbs.db
.DS_Store

# Deployment secrets (deploy/.env.example is the template).
backend/deploy/.env

# Local go-run environment with your AI key (local.env.cmd.example is the template).
backend/local.env.cmd

# The root certificate server/atp.sh ca exports.
server/atp-root-ca.crt

# The reporter tarballs server/atp.sh packs for Caddy's /downloads/.
backend/deploy/downloads/

# Local seed credentials written by setup (generated password).
backend/deploy/SEED_CREDENTIALS.local.txt
