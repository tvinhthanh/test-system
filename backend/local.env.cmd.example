@echo off
:: Environment for running api and worker locally with `go run` (cmd.exe).
:: The Go binaries never read a .env file; backend/deploy/.env is compose's.
::
::   copy local.env.cmd.example local.env.cmd     (local.env.cmd is gitignored)
::   edit local.env.cmd: put your key in LLM_API_KEY
::   then in EACH window (api and worker both call the AI):
::     call local.env.cmd
::     go run ./cmd/api          |  set "METRICS_ADDR=127.0.0.1:9091" & go run ./cmd/worker
::
:: PowerShell: run the same lines as $env:NAME="value".

:: --- Postgres ---------------------------------------------------------------
:: Default is postgres://postgres:postgres@localhost:5432/atp?sslmode=disable
:: set "DATABASE_URL=postgres://postgres:postgres@localhost:5432/atp?sslmode=disable"

:: --- AI (QD-15, QD-18) - the server's key ------------------------------------
:: Whose key it is: anthropic, openai, gemini, xai, mistral, deepseek, groq,
:: openrouter. An organization can instead save its own key in the dashboard
:: (Team -> organization -> AI settings); that one wins over this.
set "LLM_PROVIDER=openai"
set "LLM_API_KEY=sk-your-key-here"
:: Model when the organization chose none; empty = the provider's default.
:: set "LLM_MODEL="

:: --- Checker (URL check, AI drafts from a site, Auto test) --------------------
:: Run it in a third window:  cd ..\checker  &  npm start   (listens on :8090)
:: Without it the AI still drafts from your description, but cannot read pages,
:: and Auto test does not run.
set "URLCHECK=on"
set "URLCHECK_URL=http://127.0.0.1:8090"
:: Local test sites (localhost, 192.168.x.x) are blocked unless this is on -
:: set the same variable in the checker's window too.
:: set "URLCHECK_ALLOW_PRIVATE=on"
