# The only public listener (§11.5 TLS everywhere). Caddy gets a certificate
# for $DOMAIN on its own (Let's Encrypt for a real name, its internal CA for
# `localhost`), redirects http→https, and splits traffic exactly as
# frontend/README.md asks: /v1 and /healthz go to the api, everything else is
# the Vue build with a history fallback to index.html — API paths never
# receive the SPA HTML. HSTS comes from the api itself (httpx.BrowserPolicy,
# when COOKIE_SECURE=true), so one place owns the header.
{$DOMAIN} {
	encode zstd gzip

	handle /v1/* {
		reverse_proxy api:8080 {
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle /healthz {
		reverse_proxy api:8080
	}
	# Dev/staging without a bucket: OBJSTORE=memory serves presigned PUTs from
	# the api itself (OBJSTORE_MEMORY_ADDR=:9100, OBJSTORE_ENDPOINT=https://$DOMAIN/_objstore).
	# With OBJSTORE=s3 nothing hits this route — the presigned URLs point at the bucket.
	handle /_objstore/* {
		uri strip_prefix /_objstore
		reverse_proxy api:9100
	}
	# The Playwright reporter tarball server/atp.sh packs (QĐ-14), so a test
	# project installs it from here. Public like the dashboard's JS: it holds
	# no secret. A tarball's name changes with its content, so it is cached
	# for good; index.json names the current one and is never cached.
	handle /downloads/* {
		root * /srv
		file_server
		header /downloads/*.tgz Cache-Control "public, max-age=31536000, immutable"
		header /downloads/index.json Cache-Control "no-cache"
	}
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
		header Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
	}
}
