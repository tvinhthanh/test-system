# deploy/.env — copy to deploy/.env and fill in. Read by docker compose
# (interpolation) and by the app containers (env_file). §11.5: secrets live
# here or in a secret manager, never in the image or the repo. Every variable
# is validated at boot by internal/platform/config; a bad value exits 2.

# --- required -------------------------------------------------------------
# Password of the `atp` Postgres role created on first start.
POSTGRES_PASSWORD=change-me-32-random-bytes
# HMAC key for ingest-token and session hashes (§11.4), at least 32 bytes; also
# the root of the key that seals MFA secrets (§11.2). Rotating it invalidates
# every token and session AND every enrolled authenticator — users must set
# up MFA again. `openssl rand -hex 32`.
TOKEN_PEPPER=change-me-64-hex-chars-from-openssl-rand-hex-32
# Public name Caddy serves and gets a certificate for. `localhost` for a
# local staging (Caddy's internal CA); a DNS name pointing here for real.
DOMAIN=localhost
# Browser origins allowed to make cookie-authenticated writes (§11.2) and the
# CORS allowlist (§11.5). Exactly the dashboard's origin, never *.
DASHBOARD_ORIGINS=https://localhost

# --- object store (§7.7) — required outside dev --------------------------
# S3 or R2. OBJSTORE=memory is refused when APP_ENV is not dev; for a dev/CI
# stack without a bucket set OBJSTORE=memory and OBJSTORE_ENDPOINT to
# https://$DOMAIN/_objstore — Caddy forwards the presigned PUTs to the api's
# in-memory bucket (objects vanish with the api process).
OBJSTORE=s3
OBJSTORE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
OBJSTORE_REGION=auto
OBJSTORE_BUCKET=atp-artifacts-staging
OBJSTORE_ACCESS_KEY=
OBJSTORE_SECRET_KEY=

# --- optional, with defaults --------------------------------------------
# dev | staging | prod. prod additionally refuses sslmode=disable; this
# compose talks plaintext to Postgres on its private network, so it is staging.
APP_ENV=staging
# Session cookies carry Secure (default true). false is dev-only.
COOKIE_SECURE=true
# Dashboard requests per signed-in user per minute, burst 2× (§11.6 API4).
DASHBOARD_RATE_PER_MINUTE=600
# How long finished queue jobs stay before the worker prunes them (T5).
JOB_RETENTION=168h
# Days of pg_dump files the backup container keeps in its volume.
BACKUP_KEEP_DAYS=14
# Image tag compose builds/runs; set to a registry tag for a pulled image.
ATP_IMAGE=atp/backend:local

# Host ports Caddy publishes (defaults 80/443); change when another server owns them.
HTTP_PORT=80
HTTPS_PORT=443
