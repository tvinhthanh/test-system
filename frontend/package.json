{
  "name": "atp-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:fixture": "vite --mode fixture --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "build": "npm run typecheck && vite build && node scripts/check-bundle.mjs && node scripts/copy-trace-viewer.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lucide/vue": "1.45.0",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "pinia": "3.0.4",
    "reka-ui": "2.10.4",
    "tailwind-merge": "3.7.0",
    "uqr": "0.1.3",
    "vue": "3.5.42",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.6",
    "jsdom": "^26.0.0",
    "playwright-core": "1.63.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "~5.9.3",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.11"
  }
}
