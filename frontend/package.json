{
  "name": "atp-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:fixture": "vite --mode fixture --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "build": "npm run typecheck && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@lucide/vue": "1.45.0",
    "pinia": "^3.0.0",
    "vue": "3.5.42",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.6",
    "jsdom": "^26.0.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
